# No credentials are required for the three UI agents.
# local = persistent browser prototype; /demo is an isolated in-memory example.
# live connects Clerk, Convex and OpenAI, including account-scoped onboarding.
NEXT_PUBLIC_MOVABLE_MODE=local

# Live frontend configuration. Never expose server secrets.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Convex server environment: CLERK_FRONTEND_API_URL, OPENAI_API_KEY.
# OPENAI_MODEL is optional; the backend defaults to gpt-6.1-sol.
